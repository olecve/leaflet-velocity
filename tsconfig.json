{
  "compilerOptions": {
    // Must stay ES5 — Leaflet's Class.extend() mixin needs enumerable prototype methods; native classes aren't.
    "target": "ES5",
    "lib": ["ES2020", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "demo", "**/*.spec.ts"]
}
