{
  "name": "@olecve/leaflet-velocity",
  "version": "1.2.0",
  "description": "Visualise velocity layers with leaflet (Typescript fork)",
  "license": "MIT",
  "author": "Dan Wild <danwild@y7mail.com>",
  "contributors": [
    "Cyrille Meichel <me@noopy.fr>",
    "Jordan N. <me@0nza.dev>",
    "Oleg Tsvetkov <olecve@gmail.com>"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/leaflet-velocity.css"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm run fmt:check && npm run lint && npm run knip && npm run build && npm run test",
    "demo": "npm run build && vite",
    "fmt": "prettier --write . && sort-package-json",
    "fmt:check": "prettier --check . && sort-package-json --check",
    "knip": "knip",
    "knip:ci": "knip --no-progress --reporter compact",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "^1.9.19",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "^25.0.0",
    "knip": "6.38.0",
    "leaflet": "1.9.4",
    "prettier": "3.9.9",
    "sort-package-json": "4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "leaflet": ">=1.0.0"
  }
}
